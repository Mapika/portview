# Maintainer: Mapika <https://github.com/Mapika>
pkgname=portview
pkgver=1.2.1
pkgrel=1
pkgdesc='A diagnostic-first port viewer. See what is on your ports, then act on it.'
arch=('x86_64' 'aarch64')
url='https://github.com/Mapika/portview'
license=('MIT')
depends=()
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Mapika/portview/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release

    # Completions and man page are generated by build.rs
    local _outdir
    _outdir=$(find target/release/build -path '*/portview-*/out' -type d | head -1)
    install -Dm644 "$_outdir/man/portview.1" man/portview.1
    install -Dm644 "$_outdir/completions/portview.bash" completions/portview.bash
    install -Dm644 "$_outdir/completions/_portview" completions/_portview
    install -Dm644 "$_outdir/completions/portview.fish" completions/portview.fish
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/portview "$pkgdir/usr/bin/portview"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 man/portview.1 "$pkgdir/usr/share/man/man1/portview.1"
    install -Dm644 completions/portview.bash "$pkgdir/usr/share/bash-completion/completions/portview"
    install -Dm644 completions/_portview "$pkgdir/usr/share/zsh/site-functions/_portview"
    install -Dm644 completions/portview.fish "$pkgdir/usr/share/fish/vendor_completions.d/portview.fish"
}
