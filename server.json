{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Mapika/portview",
  "title": "portview",
  "description": "Query ports and processes, run diagnostics, compare port snapshots, and terminate processes over MCP.",
  "repository": {
    "url": "https://github.com/Mapika/portview",
    "source": "github"
  },
  "websiteUrl": "https://github.com/Mapika/portview",
  "version": "2.1.0",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "portview",
      "version": "2.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "valueHint": "subcommand"
        }
      ]
    }
  ]
}
